rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function nonnegative(value) { return value is number && value >= 0; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() <= 24
        && nonnegative(request.resource.data.exp)
        && nonnegative(request.resource.data.stars.yellow)
        && nonnegative(request.resource.data.stars.purple)
        && nonnegative(request.resource.data.tickets.normal)
        && nonnegative(request.resource.data.tickets.gold);
      allow delete: if false;
      match /expenses/{entryId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 9999999
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 32
          && (!('kind' in request.resource.data) || request.resource.data.kind in ['expense', 'income', 'transfer']);
        // Ledger deletion is a versioned tombstone, not destructive removal.
        allow delete: if false;
      }
      match /days/{date} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && (!('spent' in request.resource.data) || nonnegative(request.resource.data.spent))
          && (!('income' in request.resource.data) || nonnegative(request.resource.data.income))
          && (!('entryCount' in request.resource.data) || nonnegative(request.resource.data.entryCount));
        allow delete: if false;
      }
      match /backups/{backupId} {
        allow read, create, update: if owner(uid);
        allow delete: if false;
      }
    }
  }
}
